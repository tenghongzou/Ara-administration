# API 設定
VITE_API_HOST=http://localhost
VITE_API_VERSION=v1

# WebSocket 設定
VITE_WS_URL=ws://localhost:8081/ws

# 應用程式設定
VITE_APP_NAME=Admin Dashboard
VITE_APP_VERSION=1.0.0

# 除錯模式
VITE_DEBUG=false

# Demo 模式 (啟用 mock API)
# VITE_APP_ENV=demo_mock

# 聊天服務(Rust microservice)
# 開發環境:保持未設定 —— config.ts 會落到相對路徑 /chat/*,由 Vite proxy
#           轉發到 chat:8082。
# 正式環境:必須設成絕對位址。正式前端由 Cloudflare Pages 提供,那裡是純靜態
#           站台、沒有反向代理,相對路徑會打到 Pages 本身而不是後端。
#           對應的 /chat/* 路由已在 gateway Caddy 白名單內。
# VITE_CHAT_API_URL=https://api-ara.pervive.cc/chat/api/v1
# VITE_CHAT_WS_URL=wss://ws-ara.pervive.cc/chat/ws
